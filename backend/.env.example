# Desenvolvimento SEM Docker (PostgreSQL instalado no Windows). Copie para .env
# PostgreSQL instalado no Windows:
#DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/orquestrador
# PostgreSQL no Docker (docker compose up postgres -d), usuário e senha do .env da raiz:
DATABASE_URL=postgresql://orq:SENHA_DO_POSTGRES_PASSWORD@localhost:5432/orquestrador
JWT_SECRET=troque-por-um-segredo-com-no-minimo-32-caracteres
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
SEED_EMAIL=admin@demo.local
SEED_PASSWORD=troque-esta-senha
# true = permite simular o runner (botão "Simular" na tela Máquinas). Em produção: false
DEMO_MODE=true
